{
  "name": "the-commission-bot",
  "version": "3.6.9",
  "description": "The Commission - Railway web control room, Windows control panel, Discord protection and Going Live scheduler",
  "main": "desktop/main.js",
  "author": "Rykeen-sargeras",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "start:bot": "node discord_bootstrap.js",
    "railway:start": "node railway_start.js",
    "check": "node scripts/check-syntax.js",
    "test": "node scripts/run-tests.js",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "@distube/ytdl-core": "^4.16.12",
    "discord.js": "^14.21.0",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.15",
    "play-dl": "^1.9.7",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12"
  },
  "engines": {
    "node": ">=22.13"
  },
  "build": {
    "appId": "com.rykeen.thecommission",
    "productName": "The Commission",
    "copyright": "Copyright © 2026 Rykeen-sargeras",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "desktop/**/*",
      "discord/**/*",
      "railway/**/*",
      "blueprint.js",
      "address_verification.js",
      "manual_jail_role.js",
      "economy.js",
      "economy/**/*.js",
      "moderation_word_policy.js",
      "economy_discord.js",
      "going_live.js",
      "going_live_time.js",
      "going_live_preload.js",
      "going_live_command_guard.js",
      "open_panel_preload.js",
      "youtube_role_permissions.js",
      "membership_store.js",
      "membership_youtube.js",
      "membership_web.js",
      "membership_discord.js",
      "dm_ticket_system.js",
      "permissions_bridge.js",
      "permissions_web_preload.js",
      "discord_bootstrap.js",
      "discord_features.js",
      "memberbridge/integration.js",
      "docs/**/*",
      "assets/commission-mark.png",
      "assets/app-icon.ico",
      "assets/going-live-schedule.png",
      "live_voice_pairs.js",
      "discord_bot.js",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "The Commission",
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
