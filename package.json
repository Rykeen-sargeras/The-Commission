{
  "name": "the-commission-bot",
  "version": "3.6.1",
  "description": "The Commission - Railway web control room, Windows control panel, Discord protection and Going Live scheduler",
  "main": "desktop/main.js",
  "author": "Rykeen-sargeras",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "start:bot": "node discord_bootstrap.js",
    "railway:start": "node -r ./going_live_preload.js railway_start.js",
    "check": "node --check discord_bot.js && node --check discord_bootstrap.js && node --check going_live.js && node --check going_live_command_guard.js && node --check going_live_preload.js && node --check economy.js && node --check economy_discord.js && node --check railway_start.js && node --check desktop/main.js && node --check desktop/preload.js && node --check desktop/renderer.js && node --check memberbridge/integration.js",
    "test": "node tests/preemptive-ban.test.js && node tests/blueprint.test.js && node tests/economy.test.js && node tests/memberbridge-retirement.test.js",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "@distube/ytdl-core": "^4.16.12",
    "discord.js": "^14.21.0",
    "ffmpeg-static": "^5.2.0",
    "libsodium-wrappers": "^0.7.15",
    "play-dl": "^1.9.7"
  },
  "devDependencies": {
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12"
  },
  "engines": {
    "node": ">=22.13"
  },
  "build": {
    "appId": "com.rykeen.thecommission",
    "productName": "The Commission",
    "copyright": "Copyright © 2026 Rykeen-sargeras",
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "files": [
      "desktop/**/*",
      "tests/**/*",
      "blueprint.js",
      "economy.js",
      "economy_discord.js",
      "going_live.js",
      "going_live_preload.js",
      "going_live_command_guard.js",
      "discord_bootstrap.js",
      "memberbridge/integration.js",
      "docs/**/*",
      "assets/commission-mark.png",
      "assets/app-icon.ico",
      "discord_bot.js",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "The Commission",
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
