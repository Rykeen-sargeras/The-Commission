# YouTube membership verifier. These can also be entered on Membership Setup.
MEMBERSHIP_PUBLIC_BASE_URL=https://YOUR-DOMAIN.up.railway.app
MEMBERSHIP_GUILD_ID=REPLACE_WITH_DISCORD_SERVER_ID
MEMBERSHIP_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
MEMBERSHIP_GOOGLE_CLIENT_SECRET=REPLACE_IN_RAILWAY
MEMBERSHIP_DISCORD_CLIENT_ID=REPLACE_WITH_DISCORD_APPLICATION_ID
MEMBERSHIP_DISCORD_CLIENT_SECRET=REPLACE_IN_RAILWAY
MEMBERSHIP_ENCRYPTION_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
MEMBERSHIP_STATE_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
