COMMISSION_RAILWAY_MODE=true
WEB_DASHBOARD_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_OWNER_PASSWORD
CLIPPER_PASSWORD=REPLACE_WITH_A_SHARED_CLIPPER_PASSWORD
